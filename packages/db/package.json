{
  "name": "@chohee/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config=drizzle.config.ts",
    "migrate:local": "wrangler d1 migrations apply chohee --local --config ../../apps/api/wrangler.toml",
    "migrate:prod": "wrangler d1 migrations apply chohee --remote --config ../../apps/api/wrangler.toml",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@chohee/shared": "workspace:*",
    "drizzle-orm": "^0.33.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.24.2",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
