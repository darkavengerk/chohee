# ─────────────────────────────────────────────────────
# Chohee 환경 변수 예시. 실제 값은 .env.local 또는 wrangler secret에 보관.
# ─────────────────────────────────────────────────────

# ── apps/web (Next.js) ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_KAKAO_JS_KEY=__kakao_javascript_key__
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000

# ── apps/api (Cloudflare Workers) ──
# wrangler.toml의 [vars]와 [env].vars에 들어가거나 wrangler secret으로 등록
KAKAO_CLIENT_ID=__kakao_rest_api_key__
KAKAO_CLIENT_SECRET=__kakao_client_secret__
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
JWT_SECRET=__minimum_32_byte_random_string__
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
WEB_ORIGIN=http://localhost:3000

# ── Cloudflare R2 (presigned URL용 S3 호환 자격증명) ──
R2_ACCOUNT_ID=__cloudflare_account_id__
R2_ACCESS_KEY_ID=__r2_access_key__
R2_SECRET_ACCESS_KEY=__r2_secret_key__
R2_BUCKET_NAME=chohee-media
R2_PUBLIC_BASE_URL=https://media.example.com
