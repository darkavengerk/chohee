{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "chohee",
  "description": "Chohee — AI music & lyrics sharing platform. Warm-charcoal dark mode with restrained mustard accent.",
  "version": "0.4.0",

  "color": {
    "bg": {
      "0": { "value": "oklch(0.155 0.008 60)", "hex": "#1a1816", "description": "page background, deepest surface" },
      "1": { "value": "oklch(0.185 0.008 60)", "hex": "#21201d", "description": "card / raised surface" },
      "2": { "value": "oklch(0.22 0.008 60)",  "hex": "#272623", "description": "modal / hover" },
      "3": { "value": "oklch(0.27 0.008 60)",  "hex": "#2f2d2a", "description": "input / chip" },
      "4": { "value": "oklch(0.32 0.008 60)",  "hex": "#3a3835", "description": "strong divider" }
    },
    "fg": {
      "1": { "value": "oklch(0.96 0.012 85)",  "hex": "#f5f1e8", "description": "primary text — cream off-white" },
      "2": { "value": "oklch(0.82 0.012 80)",  "hex": "#c8c2b3", "description": "secondary body" },
      "3": { "value": "oklch(0.65 0.01 75)",   "hex": "#9c958a", "description": "muted / metadata / placeholder" },
      "4": { "value": "oklch(0.48 0.008 70)",  "hex": "#736e66", "description": "disabled / line numbers" }
    },
    "bd": {
      "1": { "value": "oklch(0.28 0.008 60)",  "hex": "#322f2c", "description": "default border" },
      "2": { "value": "oklch(0.36 0.008 60)",  "hex": "#433f3a", "description": "emphasized border" }
    },
    "accent": {
      "default":    { "value": "oklch(0.82 0.14 92)", "hex": "#dac257", "description": "main accent — mustard" },
      "soft":       { "value": "oklch(0.82 0.14 92 / 0.14)", "description": "tinted background, 14% alpha" },
      "fg":         { "value": "oklch(0.18 0.02 60)", "hex": "#1f1d1a", "description": "text on accent fill" },
      "secondary":  { "value": "oklch(0.62 0.11 50)", "hex": "#b07c52", "description": "warm secondary — terracotta-ish" },
      "variants": {
        "mustard":    { "value": "oklch(0.82 0.14 92)", "hex": "#dac257", "description": "default" },
        "amber":      { "value": "oklch(0.78 0.14 70)", "hex": "#d4a356" },
        "terracotta": { "value": "oklch(0.66 0.13 38)", "hex": "#bf6f48" },
        "coral":      { "value": "oklch(0.74 0.15 28)", "hex": "#e08866" }
      }
    },
    "semantic": {
      "info":    { "value": "oklch(0.72 0.07 230)", "hex": "#7da4c2" },
      "success": { "value": "oklch(0.72 0.1 150)",  "hex": "#7fb89a" },
      "warn":    { "value": "oklch(0.8  0.13 80)",  "hex": "#d6b966" },
      "danger":  { "value": "oklch(0.66 0.16 25)",  "hex": "#cf6855" }
    },
    "status": {
      "waiting":    { "value": "oklch(0.6 0.02 70)",  "hex": "#9a9189", "label": "음악 대기 중", "pulse": false },
      "generating": { "value": "oklch(0.78 0.14 70)", "hex": "#d4a356", "label": "생성 중",      "pulse": true  },
      "complete":   { "value": "oklch(0.72 0.1 150)", "hex": "#7fb89a", "label": "완성",         "pulse": false },
      "revision":   { "value": "oklch(0.68 0.13 40)", "hex": "#c47d59", "label": "보완 요청",     "pulse": false }
    }
  },

  "font": {
    "family": {
      "sans":  { "value": "\"Pretendard Variable\", -apple-system, \"Apple SD Gothic Neo\", \"Malgun Gothic\", sans-serif", "description": "UI · body · metadata" },
      "serif": { "value": "\"Noto Serif KR\", \"Nanum Myeongjo\", \"본명조\", \"Source Serif 4\", serif",                   "description": "lyrics · display · artwork text" },
      "mono":  { "value": "\"JetBrains Mono\", \"SF Mono\", ui-monospace, monospace",                                       "description": "time · ID · stats" }
    },
    "scale": {
      "display-xl": { "size": "64-88px", "lineHeight": 1.05, "family": "serif", "letterSpacing": "0.005em", "use": "lyrics page title" },
      "display":    { "size": "48-56px", "lineHeight": 1.1,  "family": "serif", "letterSpacing": "0.005em", "use": "hero title" },
      "title":      { "size": "32-40px", "lineHeight": 1.2,  "family": "serif", "letterSpacing": "0.005em", "use": "screen title" },
      "subtitle":   { "size": "22-26px", "lineHeight": 1.35, "family": "serif", "letterSpacing": "0.005em", "use": "card title · section head" },
      "body-lg":    { "size": "16px",    "lineHeight": 1.7,  "family": "sans",  "letterSpacing": "-0.005em" },
      "body":       { "size": "14px",    "lineHeight": 1.55, "family": "sans",  "letterSpacing": "-0.005em" },
      "caption":    { "size": "12px",    "lineHeight": 1.4,  "family": "sans",  "letterSpacing": "-0.005em" },
      "mono":       { "size": "10.5-12px","lineHeight": 1.4, "family": "mono",  "letterSpacing": 0 }
    },
    "lyrics": {
      "description": "Lyrics are first-class content. Always serif, generous line-height, keep-all word break.",
      "base":  { "size": "22px", "lineHeight": 1.95, "letterSpacing": "0.01em",  "whiteSpace": "pre-wrap", "wordBreak": "keep-all" },
      "lg":    { "size": "28px", "lineHeight": 2.05, "letterSpacing": "0.01em" },
      "xl":    { "size": "36px", "lineHeight": 2.0,  "letterSpacing": "0.012em" },
      "stanzaGap": "1.4em",
      "rules": [
        "Always serif (Noto Serif KR)",
        "Preserve author's line breaks (pre-wrap)",
        "Never auto-center lyrics; respect author's intent",
        "Emphasize chorus with accent color or italic only — never bold sans"
      ]
    }
  },

  "spacing": {
    "1":  { "value": "4px",  "use": "icon-text gap" },
    "2":  { "value": "8px",  "use": "chip inner / button gap" },
    "3":  { "value": "12px", "use": "small group" },
    "4":  { "value": "16px", "use": "card inner standard" },
    "5":  { "value": "20px", "use": "input group" },
    "6":  { "value": "24px", "use": "section inner" },
    "8":  { "value": "32px", "use": "card padding / between sections" },
    "10": { "value": "40px", "use": "page padding x" },
    "12": { "value": "48px", "use": "large section gap" },
    "16": { "value": "64px", "use": "hero padding" },
    "20": { "value": "80px", "use": "page padding y" },
    "24": { "value": "96px", "use": "screen-level breathing" }
  },

  "radius": {
    "xs":   { "value": "4px",   "use": "chip-inner accent / inline code" },
    "sm":   { "value": "6px",   "use": "small chip / highlight" },
    "md":   { "value": "10px",  "use": "button / input / menu item" },
    "lg":   { "value": "14px",  "use": "card / modal" },
    "xl":   { "value": "20px",  "use": "hero / large container" },
    "pill": { "value": "999px", "use": "chip / status badge / follow" }
  },

  "shadow": {
    "1": { "value": "0 1px 0 oklch(1 0 0 / 0.04) inset, 0 1px 2px oklch(0 0 0 / 0.25)",   "use": "card" },
    "2": { "value": "0 1px 0 oklch(1 0 0 / 0.04) inset, 0 4px 12px oklch(0 0 0 / 0.32)",  "use": "hover / modal" },
    "3": { "value": "0 1px 0 oklch(1 0 0 / 0.05) inset, 0 12px 32px oklch(0 0 0 / 0.42)", "use": "popover / floating footer player" }
  },

  "motion": {
    "duration": {
      "fast": { "value": "120ms", "use": "hover / focus / button press" },
      "base": { "value": "200ms", "use": "card hover / tab switch" },
      "slow": { "value": "360ms", "use": "panel open / progress fill" },
      "page": { "value": "480ms", "use": "page transition / skeleton fade" }
    },
    "easing": {
      "default": { "value": "cubic-bezier(0.2, 0.7, 0.3, 1)",  "use": "general" },
      "out":     { "value": "cubic-bezier(0.16, 1, 0.3, 1)",   "use": "entrance" }
    },
    "keyframes": {
      "pulse": { "duration": "1.8s", "easing": "var(--ease)", "use": "generating-status dot" },
      "wave":  { "duration": "0.9s", "easing": "ease-in-out", "use": "waveform playback bar" }
    }
  },

  "component": {
    "button": {
      "sizes": {
        "sm": { "height": "28px", "padding": "6px 12px",  "fontSize": "12px" },
        "md": { "height": "36px", "padding": "9px 16px",  "fontSize": "13px" },
        "lg": { "height": "44px", "padding": "12px 22px", "fontSize": "14px" }
      },
      "variants": ["primary", "secondary", "outline", "ghost", "danger"]
    },
    "statusBadge": {
      "kinds": ["waiting", "generating", "complete", "revision"],
      "shape": "pill",
      "background": "12% alpha of status color",
      "border": "22% alpha of status color"
    },
    "chip": {
      "shape": "pill",
      "sizes": ["sm", "md", "lg"],
      "states": ["default", "active"]
    },
    "card": {
      "kinds": ["SongCard", "LyricsCard", "AlbumCard"],
      "cover": "image-slot web component (user drag-and-drop, persistent)",
      "coverAspect": "1 / 1"
    },
    "player": {
      "waveform": { "bars": 92, "height": "56-64px" },
      "footer":   { "position": "fixed bottom", "blur": "20px saturate(160%)" }
    },
    "sidebar":  { "width": "248px", "groups": ["explore", "create"] },
    "topbar":   { "sticky": true, "searchMaxWidth": "480px" }
  },

  "accessibility": {
    "minTapTarget": "44px",
    "minBodyFontSize": "12px",
    "contrastTargets": {
      "fg-1 on bg-0": "AAA",
      "fg-2 on bg-1": "AA",
      "accent on bg-0": "AA (large text)"
    },
    "focus": "2px solid var(--accent), 2px offset"
  }
}
