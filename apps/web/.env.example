# apps/web 환경 변수. 루트의 .env.example을 보고 web 관련만 채워 .env.local로 저장.
#
# 서버 전용 (브라우저에 노출되지 않음, $env/static/private 또는 $env/dynamic/private)
API_BASE_URL=http://localhost:8787

# 클라이언트 노출 가능 ($env/static/public 또는 $env/dynamic/public)
# 카카오 OAuth는 redirect_uri가 카카오 콘솔에 사전 등록돼 있어야 동작.
PUBLIC_API_BASE_URL=http://localhost:8787
PUBLIC_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
PUBLIC_WEB_ORIGIN=http://localhost:5173
